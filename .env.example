# LLM (OpenAI-compatible chat completions)
# openrouter (default) | avalai | custom
LLM_PROVIDER=openrouter
# OpenRouter key (sk-or-...) or avalai key, depending on LLM_PROVIDER
LLM_API_KEY=
# Optional overrides; each provider has defaults:
#   openrouter -> https://openrouter.ai/api/v1, anthropic/claude-sonnet-5.5
#   avalai     -> https://api.avalai.ir/v1,     claude-sonnet-5-5
# LLM_BASE_URL=
# LLM_MODEL=
# low | medium | high | xhigh | none (default medium)
LLM_REASONING_EFFORT=medium

# GitLab (self-hosted)
GITLAB_URL=https://gitlab.yourdomain.com
GITLAB_TOKEN=
GITLAB_PROJECT_ID=
GITLAB_DEFAULT_BRANCH=main
GITLAB_MR_TARGET_BRANCH=main
GITLAB_MR_ASSIGNEE_ID=

# OpenSearch
OPENSEARCH_URL=https://opensearch.yourdomain.com
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=logs-*
OPENSEARCH_POLL_INTERVAL_SECONDS=60
OPENSEARCH_LOOKBACK_SECONDS=120
# Document field mapping (dotted paths OK). For ECS logs use
# LEVEL_FIELD=log.level, LEVEL_VALUE=error, STACK_TRACE_FIELD=error.stack_trace,
# SERVICE_FIELD=service.name.
OPENSEARCH_LEVEL_FIELD=level
OPENSEARCH_LEVEL_VALUE=ERROR
OPENSEARCH_MESSAGE_FIELD=message
OPENSEARCH_STACK_TRACE_FIELD=stack_trace
OPENSEARCH_SERVICE_FIELD=service
OPENSEARCH_TIMESTAMP_FIELD=@timestamp

# Redis (for Asynq)
REDIS_URL=redis://localhost:6379

# App
PORT=3000
HUMAN_APPROVAL_REQUIRED=true
LOG_LEVEL=info
DB_PATH=logai.db
# Shared secret for POST /webhook/error (X-Logai-Token or Authorization: Bearer).
# Strongly recommended: without it anyone who can reach the port can trigger MRs.
WEBHOOK_SECRET=
